{% extends 'base.html.twig' %}
{% block title %}Search comparison · Giving Atlas{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-2"><h1>Search comparison</h1><a href="{{ path('browse_lab') }}">Back to AI Lab</a></div>
<p class="text-secondary">One project sample, one embedding model, two search engines. Judge which results help answer your question.</p>
{% if manifest %}<p class="small">{{ manifest.count }} active projects · {{ manifest.model }} · snapshot {{ manifest.snapshot|slice(0,12) }}. Sample: lowest source IDs, not a representative survey.</p>{% endif %}
<form method="get" class="card card-body mb-3" action="{{ path('lab_compare') }}">
<label for="query" class="form-label">What would you like to support?</label><input class="form-control mb-3" id="query" name="q" maxlength="300" value="{{ query }}" required placeholder="Help girls stay in school">
<div class="row g-3"><div class="col-md-5"><label for="mode" class="form-label">Search mode</label><select class="form-select" name="mode" id="mode">{% for value,label in {keyword:'Keywords', vector:'Meaning', hybrid:'Keywords + meaning'} %}<option value="{{ value }}" {{ mode == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div><div class="col-md-4"><label for="country" class="form-label">Country code (optional)</label><input class="form-control" name="country" id="country" maxlength="3" value="{{ country }}" placeholder="e.g. GT"></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Compare</button></div></div>
</form>
<p class="small text-secondary">Keywords + meaning combines the top 50 keyword and vector results using equal-weight reciprocal rank fusion (constant 60). Scores from different engines are not compared. Scores describe this query’s ranking, not confidence or project quality. Timings are individual requests, not benchmarks.</p>
{% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}
{% if run %}
<div class="mb-3 d-flex gap-3 align-items-center">{% if runId %}<span>Saved comparison · {{ run.createdAt }}</span><a href="{{ path('lab_compare', {q:query,mode:mode,country:country}) }}">Run again</a>{% else %}<form method="post"><input type="hidden" name="token" value="{{ token }}"><input type="hidden" name="action" value="save"><button class="btn btn-outline-primary">Save comparison to rate results</button></form>{% endif %}<span class="small text-secondary">Shared query embedding/cache lookup: {{ run.embeddingMs }} ms</span></div>
{% if manifest and run.snapshot != manifest.snapshot %}<div class="alert alert-info">This saved run uses an older snapshot. Its results and judgments are preserved.</div>{% endif %}
<div {{ stimulus_controller('comparison') }}>
{% if shared %}<div class="d-flex flex-wrap gap-3 align-items-center mb-3"><span class="badge bg-success-lt">{{ shared|length }} projects in both top tens</span><label class="form-check mb-0"><input class="form-check-input" type="checkbox" {{ stimulus_action('comparison', 'toggleShared', 'change') }}><span class="form-check-label">Hide shared projects</span></label><span class="small text-secondary">Highlighted results appear in both engines. Original ranks are preserved.</span></div>{% endif %}
<div class="row g-4">{% for engine,result in run.results %}<section class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">{{ engine == 'meili' ? 'Meilisearch' : 'Elasticsearch' }}</h2>{% if not result.error %}<span class="ms-auto small">{{ result.elapsedMs }} ms</span>{% endif %}</div><div class="card-body">
{% if result.error %}<div class="alert alert-warning">{{ result.error }}</div>{% elseif result.hits is empty %}<p>No matches.</p>{% else %}<ol class="ps-3">{% for hit in result.hits %}<li value="{{ loop.index }}" class="mb-4 p-2 rounded {{ shared[hit.id] is defined ? 'bg-success-lt' : '' }}" {% if shared[hit.id] is defined %}{{ stimulus_target('comparison', 'shared') }}{% endif %}>{% if shared[hit.id] is defined %}<p class="small fw-semibold mb-2">In both · Meili #{{ shared[hit.id].meili }} · ES #{{ shared[hit.id].elastic }}{{ shared[hit.id].meili == shared[hit.id].elastic ? ' · Same rank' : '' }}</p>{% endif %}<h3 class="h4"><a href="{{ path('project_show',{projectId:hit.id}) }}">{{ hit.title }}</a></h3><p class="small text-secondary">{{ hit.countries|join(', ') }} · {{ hit.themes|join(', ') }}</p>{% if hit.score is defined and hit.score is not null %}<p class="small mb-2"><strong>{{ mode == 'hybrid' ? 'Fusion score' : 'Relevance score' }}: {{ hit.score|number_format(4) }}</strong>{% if hit.contributions is defined %}<br>Keyword rank: {{ hit.contributions.keywordRank|default('outside top 50') }} · Vector rank: {{ hit.contributions.vectorRank|default('outside top 50') }}{% endif %}</p>{% endif %}<p>{{ hit.summary|default('')|slice(0,260) }}</p>{% if runId %}<form method="post" class="d-flex gap-2 align-items-center"><input type="hidden" name="token" value="{{ token }}"><input type="hidden" name="action" value="judge"><input type="hidden" name="run" value="{{ runId }}"><input type="hidden" name="project" value="{{ hit.id }}"><label class="visually-hidden" for="grade-{{ engine }}-{{ hit.id }}">Relevance of {{ hit.title }}</label><select class="form-select form-select-sm" id="grade-{{ engine }}-{{ hit.id }}" name="grade" required><option value="-1">Not rated</option>{% for value,label in {0:'Not relevant',1:'Somewhat relevant',2:'Useful'} %}<option value="{{ value }}" {{ grades[hit.id] is not null and grades[hit.id] == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-secondary">Rate</button></form>{% endif %}</li>{% endfor %}</ol>{% endif %}
</div></div></section>{% endfor %}</div></div>
{% endif %}
{% if saved %}<h2 class="mt-4">Saved comparisons</h2><ul>{% for id,item in saved %}<li><a href="{{ path('lab_compare',{run:id}) }}">{{ item.query }}</a> · {{ item.mode }}{{ item.country ? ' · '~item.country : '' }} · {{ item.createdAt }}</li>{% endfor %}</ul>{% endif %}
{% endblock %}
