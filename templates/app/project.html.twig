{% extends 'base.html.twig' %}
{% block title %}{{ project.title }} · Giving Atlas{% endblock %}
{% block body %}
<a href="{{ path('browse_projects') }}">← Projects</a><div class="row mt-3"><div class="col-lg-8"><div class="text-secondary mb-2">{{ project.countryCode }} · {{ project.themes|join(' / ') }}</div><h1>{{ project.title }}</h1><p class="lead">{{ project.summary }}</p>
{% if project.imageUrl %}<figure><img src="{{ project.imageUrl }}" class="img-fluid rounded w-100" alt="{{ project.title }}"><figcaption class="text-secondary small mt-2">Image: {% if project.organization %}<a href="{{ path('organization_show', project.organization.rp) }}">{{ project.organization.name }}</a>{% else %}project nonprofit{% endif %} via GlobalGiving</figcaption></figure>{% endif %}
{% for heading, text in {'The need': project.need, 'What the project does': project.activities, 'Long-term impact': project.longTermImpact} %}{% if text %}<section class="mb-4"><h2>{{ heading }}</h2><p class="narrative">{{ text }}</p></section>{% endif %}{% endfor %}</div>
<aside class="col-lg-4"><div class="card sticky-top atlas-sidebar"><div class="card-body"><span class="badge {{ project.active ? 'bg-teal-lt' : 'bg-secondary-lt' }} mb-3">{{ project.active ? 'Active' : 'Historical' }}</span>
{% if project.funding is not null %}<h2>${{ project.funding|number_format(0) }}</h2><p class="text-secondary">raised{% if project.goal %} toward ${{ project.goal|number_format(0) }}{% endif %}</p>{% endif %}
{% if project.projectUrl %}<a href="{{ project.projectUrl }}" class="btn btn-teal w-100" rel="noopener">View on GlobalGiving ↗</a>{% endif %}
<hr>{% if project.organization %}<h3>{{ project.organization.name }}</h3><a href="{{ path('organization_show', project.organization.rp) }}">Organization and research →</a>{% else %}<p>The source does not identify an organization for this historical record.</p>{% endif %}<hr><small class="text-secondary">GlobalGiving #{{ project.id }}<br>Imported {{ project.importedAt|date('M j, Y') }}. Figures reflect the source snapshot.</small></div></div></aside></div>
{% endblock %}
