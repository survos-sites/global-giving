{% extends 'base.html.twig' %}
{% block title %}{{ organization.name }} · Giving Atlas{% endblock %}
{% block body %}
<a href="{{ path('browse_organizations') }}">← Organizations</a><div class="row mt-3"><div class="col-lg-8"><h1>{{ organization.name }}</h1><p class="lead">{{ organization.mission }}</p><div class="mb-4">{{ organization.countryCode }} · {{ organization.themes|join(' / ') }}</div>
<h2>Projects</h2><div class="row row-cards">{% for project in projects %}<div class="col-md-6">{% include 'app/_card.html.twig' %}</div>{% else %}<p>No projects for this organization are in the current catalog.</p>{% endfor %}</div></div>
<aside class="col-lg-4"><div class="card"><div class="card-body">{% if organization.logoUrl %}<img class="atlas-logo mb-3" src="{{ organization.logoUrl }}" alt="{{ organization.name }}">{% endif %}<h2>Nonprofit research</h2><p>GlobalGiving #{{ organization.id }}</p>{% if organization.ein %}<p>EIN {{ organization.ein }}</p>{% endif %}
{% if organization.researchUrl %}<a href="{{ organization.researchUrl }}" class="btn btn-outline-primary w-100 mb-3" rel="noopener">ProPublica Nonprofit Explorer ↗</a>{% endif %}
{% if organization.research %}{% set research = organization.research %}<h3>{{ research.name }}</h3><p class="text-secondary">Matched by EIN · {{ research.nteeCode|default('') }}</p>{% if research.latestFiling %}{% set filing = research.latestFiling %}<p>Fiscal year {{ filing.year }}</p><dl>{% for key, label in {'revenue':'Revenue', 'expenses':'Expenses', 'assets':'Assets'} %}{% if attribute(filing, key) is not null %}<dt>{{ label }}</dt><dd>${{ attribute(filing, key)|number_format }}</dd>{% endif %}{% endfor %}</dl>{% if filing.url %}<a href="{{ filing.url }}">View filing ↗</a>{% endif %}{% endif %}<p class="small text-secondary mt-3">Source: ProPublica / IRS. Retrieved {{ organization.researchedAt|date('M j, Y') }}. Filing figures are organization-wide; they do not measure this project's impact.</p>
{% elseif organization.researchUrl %}<p class="text-secondary">Follow the EIN link to review IRS filings. Financial data has not been imported here yet.</p>{% else %}<p class="text-secondary">The source has no usable US EIN. No research match has been inferred from the name.</p>{% endif %}
{% if organization.url %}<hr><a href="{{ organization.url }}" rel="noopener">Organization website ↗</a>{% endif %}</div></div></aside></div>
{% endblock %}
