<article class="card h-100"><div class="card-body">{% if hit.logoUrl %}<img src="{{ hit.logoUrl }}" class="atlas-logo mb-3" alt="{{ hit.name }}" loading="lazy">{% endif %}<div class="text-secondary small mb-2">{{ hit.countryCode }}</div><h3 class="card-title"><a href="{{ hit.showUrl }}">{{ hit.name }}</a></h3><p>{{ hit.mission|default('')|slice(0,200) }}…</p><div class="small">{{ hit.totalProjects }} projects · {{ hit.themes|join(' / ') }}</div></div></article>
